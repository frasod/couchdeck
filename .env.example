# couchdeck configuration. Copy to .env and edit:  cp .env.example .env
# scripts/run.sh reads .env; the systemd unit in contrib/ reads it too.
# Every setting is optional. Values are literal (no $(...) expansion), so the
# same file works for both the shell and systemd's EnvironmentFile=.

# --- Listener -------------------------------------------------------------
# Address to bind. Use your Tailscale IPv4 (`tailscale ip -4`), or the word
# "tailscale" to look it up at start. 127.0.0.1 is the safe default and only
# reachable from this machine (or through `tailscale serve`).
COUCHDECK_BIND=127.0.0.1
COUCHDECK_PORT=3320

# --- Sessions -------------------------------------------------------------
# Directory whose subfolders appear in the "new session" project picker.
# Default: ~/projects
#PROJECTS_ROOT=/home/you/projects

# JSON launcher list (see README, "Launchers").
# Default: ~/.config/couchdeck/launchers.json
#COUCHDECK_LAUNCHERS=/home/you/.config/couchdeck/launchers.json

# Allow a free-text command when creating a session, instead of launchers only.
# Off by default: anyone who can reach the page can already get a shell, but
# this keeps the create form to a known list.
#COUCHDECK_ALLOW_CUSTOM_CMD=1

# Where the remembered tmux status-bar state lives.
# Default: ~/.local/state/couchdeck-status.json
#COUCHDECK_STATUS_STATE=/home/you/.local/state/couchdeck-status.json

# --- Request gate (DNS-rebinding and cross-site protection) ---------------
# Extra host names the app answers to, comma-separated, no ports. IP literals,
# localhost, this machine's hostname and its Tailscale MagicDNS name are always
# allowed. Add a reverse proxy's name or a CNAME here.
#COUCHDECK_HOSTS=deck.example.internal

# Extra origins allowed to open the terminal WebSocket, comma-separated.
# Same-origin is always allowed.
#COUCHDECK_ORIGINS=https://deck.example.internal

# couchdeck has no login. It refuses requests that arrive on a publicly
# routable address unless this is set. Do not set it on a machine reachable
# from the internet.
#COUCHDECK_ALLOW_PUBLIC=1
